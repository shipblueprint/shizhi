# China storefront runtime
APP_URL=https://cn.example.com
PORT=3000
# mainland exposes WeChat Pay when configured; international hides it
STORE_REGION=mainland

# TencentDB for PostgreSQL
DATABASE_URL=postgres://user:password@host:5432/shizhi
DATABASE_SSL=true

# Alipay Open Platform (use the sandbox gateway while testing)
ALIPAY_APP_ID=2021000000000000
ALIPAY_SELLER_ID=2088000000000000
ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# WeChat Pay API v3 Native (optional; leave disabled to show Alipay only)
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=wx0000000000000000
WECHAT_PAY_MCH_ID=1900000000
WECHAT_PAY_SERIAL_NO=...
WECHAT_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Exactly 32 bytes; also decrypts notification resources
WECHAT_PAY_API_V3_KEY=00000000000000000000000000000000
# JSON map of platform key serial to PEM, or use the two single-key variables
WECHAT_PAY_PLATFORM_PUBLIC_KEYS={"PUB_KEY_ID_...":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}
# WECHAT_PAY_PLATFORM_SERIAL=PUB_KEY_ID_...
# WECHAT_PAY_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
WECHAT_PAY_GATEWAY_URL=https://api.mch.weixin.qq.com

# Tencent COS private bucket
COS_BUCKET=example-store-1250000000
COS_REGION=ap-guangzhou
COS_SECRET_ID=...
COS_SECRET_KEY=...

# Tencent Cloud SES
SES_REGION=ap-guangzhou
SES_FROM_EMAIL="拾知 <noreply@mail.example.com>"
SES_REPLY_TO=support@example.com
SES_SECRET_ID=...
SES_SECRET_KEY=...
