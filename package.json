{
  "name": "china-store",
  "version": "1.0.0",
  "description": "China-hosted Example Store storefront: Alipay, WeChat Pay, CNY prices, private delivery.",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun run --filter china-store dev",
    "preview": "bun run --filter china-store preview",
    "build": "bun run --filter china-store build",
    "test": "bun run --filter china-store test",
    "typecheck": "bun run --filter china-store typecheck",
    "db:migrate": "bun run --filter china-store db:migrate",
    "deploy": "tcb cloudrun deploy -s china-store --source . --port 3000 --force --yes --wait"
  },
  "trustedDependencies": ["esbuild"],
  "devDependencies": {
    "@types/node": "^22.19.7",
    "typescript": "^5.9.3"
  }
}
